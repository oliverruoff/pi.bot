[Unit]
Description=pi.bot robot agent and mobile cockpit
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bot
Group=bot
SupplementaryGroups=gpio video render
WorkingDirectory=/home/bot/pi.bot
EnvironmentFile=/home/bot/pi.bot/.env
ExecStartPre=/bin/sleep 5
ExecStart=/usr/bin/python3 /home/bot/pi.bot/webserver/app.py
Restart=always
RestartSec=2
TimeoutStopSec=3

[Install]
WantedBy=multi-user.target
