[Unit]
Description=ServiceBot camera and motor test UI
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bot
Group=bot
SupplementaryGroups=gpio video render
WorkingDirectory=/home/bot/servicebot-control
ExecStartPre=/bin/sleep 5
ExecStart=/usr/bin/python3 /home/bot/servicebot-control/app.py
Restart=always
RestartSec=2
TimeoutStopSec=3

[Install]
WantedBy=multi-user.target
